# File mẫu. cai-dat.cmd tự chép thành .env (cùng thư mục) — điền key vào .env, KHÔNG điền vào file này.
# .env chỉ nằm trên máy bạn và đã có trong .gitignore (không bị đưa lên GitHub). Sửa xong chạy lại cai-dat.cmd
# để chép key Gemini/Pexels sang MoneyPrinterTurbo.

# ── Bắt buộc ──────────────────────────────────────────────────────────────────────────────────────────────────────
# Gemini: viết nháp kịch bản, đặt từ khoá / mô tả ảnh cho từng câu. Miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pexels: ảnh và clip stock miễn phí. Lấy ở https://www.pexels.com/api/ (đăng nhập → Your API Key)
PEXELS_API_KEY=

# ── Tuỳ chọn ──────────────────────────────────────────────────────────────────────────────────────────────────────
# Model Gemini (mặc định gemini-flash-latest; quá tải thì hệ thống tự thử model dự phòng)
# GEMINI_MODEL=gemini-flash-latest

# ElevenLabs: giọng podcast cho bản MoneyPrinterTurbo. elevenlabs.io → Developers → API Keys.
# Gọi giọng thư viện qua API cần gói trả phí; gói Free dùng nút "Làm giọng trên ElevenLabs" trên web (xem README).
# ELEVENLABS_API_KEY=
# Giọng podcast mặc định: mai (nữ, Hà Nội) | nhatphong (nam) | hoặc một voice_id khác trong thư viện ElevenLabs
# ELEVENLABS_VOICE=mai

# Nguồn ảnh theo câu cho mọi video (kịch bản đặt "image_source" thì kịch bản thắng):
#   pexels  ảnh chụp thật từ Pexels (mặc định)
#   comfyui tự vẽ trên GPU của máy — cài bằng cai-comfyui.cmd, bật chay-comfyui.cmd trước khi tạo video
#   gemini  vẽ bằng Gemini (cần bật thanh toán trên Google AI Studio)
#   commons ảnh thật trên Wikimedia Commons (video về người / sự kiện có thật; hiện chỉ engine MoneyPrinterTurbo dùng)
# IMAGE_SOURCE=pexels
# COMFYUI_URL=http://127.0.0.1:8188

# Số engine render cùng lúc (máy RAM 8 GB nên để 1)
# FACTORY_PARALLEL=2

# Chỉ cần khi cài ở chỗ khác mặc định:
# MPT_DIR=D:\MoneyPrinterTurbo            (mặc định engines\MoneyPrinterTurbo)
# CHROME_PATH=C:\...\chrome.exe           (mặc định tự tìm Chrome, không có thì Edge)
